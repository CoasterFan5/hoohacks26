# Auth0 Configuration
# Get these values from your Auth0 Dashboard: https://manage.auth0.com/

# Your Auth0 domain (e.g., your-tenant.us.auth0.com)
VITE_AUTH0_DOMAIN=your-domain.auth0.com

# Your Auth0 Client ID (found in your application settings)
VITE_AUTH0_CLIENT_ID=your_client_id_here

# Optional: Your Auth0 API Audience (if using an API)
# VITE_AUTH0_AUDIENCE=your_api_audience_here
